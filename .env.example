# StepFun
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-5-preview

# ---------------------------------------------------------------------------
# Phase 4: DGX Spark local model (Qwen3-VL-30B-A3B-Instruct, BF16)
# ---------------------------------------------------------------------------
# An OpenAI-compatible local vLLM server, started with
# --enable-auto-tool-choice --tool-call-parser hermes, so tool calls arrive as
# native structured message.tool_calls. Loopback only: the endpoint is this
# machine's own server, and no host or IP is baked into the code.
#
# The local server authenticates nobody, so there is no secret to configure.
# TRAILGUARD_LOCAL_API_KEY is a structural placeholder for a client that insists
# on the header; leave it empty and the code uses its own non-secret default.
# Never put a real credential in this file.

# Non-secret settings: real, non-secret values are fine here.
TRAILGUARD_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
TRAILGUARD_LOCAL_MODEL=qwen3-vl-30b-a3b
TRAILGUARD_LOCAL_API_KEY=

# Legacy Phase 0 names. Still honoured, but the names above win when both are set.
TG_LOCAL_BASE_URL=
TG_LOCAL_MODEL=
