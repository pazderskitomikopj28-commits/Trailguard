  "failure_definitions": {
    "context_limit_failure": "A run whose preserved provider error matches, case-insensitively, one of ['context length', 'context_length', 'context window', 'maximum context', 'max context', 'contextlengthexceed', 'too long', 'maximum number of tokens', 'prompt is too long', 'reduce the length of the messages', '413', 'request entity too large']. Heuristic; raw string preserved for review.",
    "infra_accident": "stop_reason 'provider_error'. Pauses the benchmark; recorded in raw; excluded from skill metrics; never deleted.",
    "max_step_failure": "stop_reason 'max_steps'. A real result, not an infra accident.",
    "not_implemented": "A Phase 0 stub being reached. Must not occur; if it does the registry is wrong.",
    "provider_failure_classes": [
      "ProviderUnavailable",
      "ProviderTimeout",
      "ProviderAuthenticationError",
      "ProviderRateLimited",
      "ProviderResponseError",
      "ProviderServerError"
    ],
    "structured_tool_call_failure": "A tool call the harness recorded with the error prefix 'invalid arguments for '. Phase 4's F-1 shape. Counted as a failure (M15) and never repaired client-side.",
    "unknown_tool": "A call naming a tool outside the registry: recorded as an outcome with no ToolCallRecord, visible in attempted_tool_calls vs trace.tool_calls."
  },
  "forbidden_during_phase5": [
    "Any client-side JSON repair, regex extraction or manual XML parsing of model output",
